#!/bin/sh
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
task="${1:-up}"
if [ "$#" -gt 0 ]; then shift; fi
build_runtime() {
  docker build --target runtime -t heyface/gateway:local services/gateway
  docker build --target runtime -t heyface/vision:local services/vision
  docker build -t heyface/web:local web
}
case "$task" in
  up|init)
    docker run --rm --user "$(id -u):$(id -g)" -v "$PWD:/workspace" -w /workspace python:3.12-slim-bookworm python scripts/bootstrap.py
    if [ "$task" = up ]; then
      build_runtime
      docker compose up -d --no-build --wait --wait-timeout 300
      printf '\nHeyface: http://localhost:%s\nAccess key: .secrets/demo-token.txt\n' "$(sed -n 's/^HTTP_PORT=//p' .env)"
    fi
    ;;
  stop) docker compose stop ;;
  status) docker compose ps ;;
  logs) docker compose logs --tail=100 "$@" ;;
  token) cat .secrets/demo-token.txt ;;
  test) docker build --target test -t heyface/vision-tests:local services/vision
        docker compose -f compose.yaml -f compose.test.yaml --profile test run --rm vision-tests
        docker build --target test -t heyface/gateway-tests:local services/gateway
        docker compose -f compose.yaml -f compose.test.yaml --profile test run --rm gateway-tests ;;
  demo|smoke|benchmark|backup|calibrate|score-pairs)
    docker compose -f compose.yaml -f compose.test.yaml --profile test run --rm tools "$task" "$@" ;;
  *) printf 'Usage: ./heyface [up|init|stop|status|logs|token|test|demo|smoke|benchmark|backup|calibrate|score-pairs]\n'; exit 2 ;;
esac
