{
  "name": "heyface/gateway",
  "description": "Stateless access gateway for local visual similarity search",
  "type": "project",
  "require": {"php": "^8.4", "laravel/framework": "13.34.0", "laravel/octane": "2.20.0"},
  "require-dev": {
    "laravel/pint": "1.32.1",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]},
  "config": {"optimize-autoloader": true, "sort-packages": true, "platform": {"php": "8.4.0"}, "allow-plugins": {}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
